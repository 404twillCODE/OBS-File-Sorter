<Window x:Class="OBSFileSorter.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="OBS File Sorter" Width="1160" Height="840" MinWidth="1010" MinHeight="740" Background="#0D111A" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" Foreground="#EDF0F7">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#121723" BorderBrush="#242C3D" BorderThickness="0,0,1,0">
      <Grid Margin="18,27,18,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
          <Border Width="44" Height="44" Background="#2B2343" CornerRadius="12" HorizontalAlignment="Left" Margin="8,0,0,13"><Viewbox Margin="10"><Path Fill="#B6A1FF" Data="M1,3 L9,3 L12,7 L23,7 L23,22 L1,22 Z M9,9 L15,9 L15,14 L19,14 L12,21 L5,14 L9,14 Z"/></Viewbox></Border>
          <TextBlock Text="OBS FILE SORTER" FontSize="13" FontWeight="Bold" Margin="8,0,0,4"/>
          <TextBlock Text="A place for every clip." FontSize="11" Foreground="{StaticResource Muted}" Margin="8,0,0,24"/>
          <Button x:Name="OverviewNav" Content="Overview" Tag="Overview" Style="{StaticResource Nav}" Click="Navigate" Background="#28223D"/>
          <Button x:Name="FoldersNav" Content="Folders" Tag="Folders" Style="{StaticResource Nav}" Click="Navigate"/>
          <Button x:Name="CleanupNav" Content="Cleanup" Tag="Cleanup" Style="{StaticResource Nav}" Click="Navigate"/>
          <Button x:Name="ActivityNav" Content="Activity" Tag="Activity" Style="{StaticResource Nav}" Click="Navigate"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="8,0">
          <TextBlock Text="QUICK SORT" Foreground="#74849C" FontSize="10" FontWeight="Bold" Margin="0,0,0,9"/>
          <StackPanel Orientation="Horizontal"><Border Background="#252D3D" CornerRadius="5" Padding="9,5"><TextBlock Text="F9" FontFamily="Consolas" FontSize="12"/></Border><TextBlock Text=" or " VerticalAlignment="Center" Foreground="#74849C"/><Border Background="#252D3D" CornerRadius="5" Padding="9,5"><TextBlock Text="F14" FontFamily="Consolas" FontSize="12"/></Border></StackPanel>
          <TextBlock Text="Sort after a 5-second delay." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,9,0,0"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="32,27,32,18">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock x:Name="PageTitle" Text="Your recording workspace" FontSize="27" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="Clips organized. Originals handled the way you configured." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,7,0,0"/></StackPanel>
        <Button x:Name="SortButton" Grid.Column="1" Content="Sort clips" Background="#A790F4" Foreground="#161123" FontWeight="SemiBold" VerticalAlignment="Center" Padding="24,12" Click="SortClips"/>
      </Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
          <StackPanel x:Name="OverviewView">
            <Border Background="#191C2D" BorderBrush="#39304F" BorderThickness="1" CornerRadius="12" Padding="23,17" Margin="0,0,0,20">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="READY WHEN YOU ARE" Foreground="#BDAAFF" FontSize="10" FontWeight="Bold"/><TextBlock Text="One click. Everything in its place." FontSize="21" FontWeight="SemiBold" Margin="0,7,0,9"/><TextBlock Text="Sort MP4 files into dated folders with numbered filenames." Foreground="#ACB5C8" FontSize="12"/></StackPanel>
                <Border Grid.Column="1" Background="#153630" CornerRadius="7" Padding="11,7" VerticalAlignment="Top"><TextBlock x:Name="MonitorBadge" Text="●  Vault monitoring" Foreground="#5EE0C3" FontSize="11"/></Border>
              </Grid>
            </Border>
            <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Background="{StaticResource Surface}" CornerRadius="10" Padding="20,17"><StackPanel><TextBlock Text="WAITING TO SORT" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><TextBlock Text="{Binding Pending}" FontSize="31" FontWeight="SemiBold"/><TextBlock Text=" MP4 files" FontSize="13" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="7,0,0,5"/></StackPanel></StackPanel></Border>
              <Border Grid.Column="2" Background="{StaticResource Surface}" CornerRadius="10" Padding="20,17"><StackPanel><TextBlock Text="CLEANUP" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><TextBlock Text="{Binding CleanupSummary}" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock Text="Your saved thresholds are unchanged." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel></Border>
            </Grid>
            <TextBlock Text="FOLDER ROUTING" Foreground="#8291A8" FontWeight="Bold" FontSize="10" Margin="0,0,0,10"/>
            <Border Background="{StaticResource Surface}" CornerRadius="9" Padding="18,11" Margin="0,0,0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Source" Foreground="#AFA1E7" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding SourceFolder}" ToolTip="{Binding SourceFolder}" FontFamily="Consolas" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><Button Grid.Column="2" Content="Open" Tag="source_folder" Click="OpenFolder" Padding="12,6" Margin="12,0,0,0"/></Grid></Border>
            <Border Background="{StaticResource Surface}" CornerRadius="9" Padding="18,11" Margin="0,0,0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Vertical clips" Foreground="#62D9C5" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding BacktrackFolder}" ToolTip="{Binding BacktrackFolder}" FontFamily="Consolas" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><Button Grid.Column="2" Content="Open" Tag="backtrack_folder" Click="OpenFolder" Padding="12,6" Margin="12,0,0,0"/></Grid></Border>
            <Border Background="{StaticResource Surface}" CornerRadius="9" Padding="18,11" Margin="0,0,0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Horizontal clips" Foreground="#7DAFF6" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding ReplayFolder}" ToolTip="{Binding ReplayFolder}" FontFamily="Consolas" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><Button Grid.Column="2" Content="Open" Tag="replay_folder" Click="OpenFolder" Padding="12,6" Margin="12,0,0,0"/></Grid></Border>
            <Border Background="{StaticResource Surface}" CornerRadius="9" Padding="18,11" Margin="0,0,0,19"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Recordings" Foreground="#F1C783" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding RecordingFolder}" ToolTip="{Binding RecordingFolder}" FontFamily="Consolas" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><Button Grid.Column="2" Content="Open" Tag="recording_folder" Click="OpenFolder" Padding="12,6" Margin="12,0,0,0"/></Grid></Border>
            <Border Background="#132824" BorderBrush="#21463E" BorderThickness="1" CornerRadius="10" Padding="20,16"><StackPanel><Grid><TextBlock Text="The Vault" FontSize="16" FontWeight="SemiBold" Foreground="#75E2CA"/><TextBlock Text="Fortnite   ·   R.E.P.O   ·   Random" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="#9BBDB4"/></Grid><TextBlock Text="{Binding VaultFolder}" ToolTip="{Binding VaultFolder}" TextTrimming="CharacterEllipsis" FontFamily="Consolas" FontSize="12" Margin="0,9,0,0"/><TextBlock Text="Files placed in a dated folder’s The Vault are copied here automatically." TextWrapping="Wrap" FontSize="11" Foreground="#94ADA7" Margin="0,7,0,0"/></StackPanel></Border>
          </StackPanel>
          <StackPanel x:Name="FoldersView" Visibility="Collapsed">
            <TextBlock Text="Keep the same folders, or choose a new destination." Foreground="{StaticResource Muted}" FontSize="13" Margin="0,0,0,20"/>
            <TextBlock Text="Source folder" FontWeight="SemiBold" Margin="0,0,0,7"/><Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding SourceFolder,UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="1" Content="Browse…" Tag="source_folder" Click="BrowseFolder" Margin="10,0,0,0"/></Grid>
            <TextBlock Text="Vertical / Backtrack clips" FontWeight="SemiBold" Margin="0,0,0,7"/><Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding BacktrackFolder,UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="1" Content="Browse…" Tag="backtrack_folder" Click="BrowseFolder" Margin="10,0,0,0"/></Grid>
            <TextBlock Text="Horizontal / Replay clips" FontWeight="SemiBold" Margin="0,0,0,7"/><Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding ReplayFolder,UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="1" Content="Browse…" Tag="replay_folder" Click="BrowseFolder" Margin="10,0,0,0"/></Grid>
            <TextBlock Text="Recordings" FontWeight="SemiBold" Margin="0,0,0,7"/><Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding RecordingFolder,UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="1" Content="Browse…" Tag="recording_folder" Click="BrowseFolder" Margin="10,0,0,0"/></Grid>
            <TextBlock Text="Vault destination" FontWeight="SemiBold" Margin="0,0,0,7"/><Grid Margin="0,0,0,23"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding VaultFolder,UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="1" Content="Browse…" Tag="vault_destination_folder" Click="BrowseFolder" Margin="10,0,0,0"/></Grid>
            <Button Content="Save folder settings" Background="#A790F4" Foreground="#161123" Click="SaveSettings" HorizontalAlignment="Left"/>
          </StackPanel>
          <StackPanel x:Name="CleanupView" Visibility="Collapsed">
            <Border Background="{StaticResource Surface}" CornerRadius="11" Padding="23" Margin="0,0,0,18"><StackPanel><CheckBox Content="Delete short recordings" IsChecked="{Binding AutoDelete}"/><TextBlock Text="Uses your existing duration threshold. Backtrack and Replay clips are kept." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="22,10,0,20"/><StackPanel Orientation="Horizontal" Margin="22,0,0,0"><TextBox Text="{Binding Minutes,UpdateSourceTrigger=PropertyChanged}" Width="75"/><TextBlock Text="minutes or shorter" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel></StackPanel></Border>
            <Border Background="{StaticResource Surface}" CornerRadius="11" Padding="23" Margin="0,0,0,23"><StackPanel><CheckBox Content="Delete old date folders" IsChecked="{Binding DeleteFolders}"/><TextBlock Text="Cleans dated clip and recording folders, including the files inside them." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="22,10,0,20"/><StackPanel Orientation="Horizontal" Margin="22,0,0,0"><TextBox Text="{Binding Days,UpdateSourceTrigger=PropertyChanged}" Width="75"/><TextBlock Text="days old" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel></StackPanel></Border>
            <Button Content="Save cleanup settings" Background="#A790F4" Foreground="#161123" Click="SaveSettings" HorizontalAlignment="Left"/>
            <TextBlock Text="Both options follow the same processing rules as the original sorter." TextWrapping="Wrap" Foreground="#74849C" FontSize="12" Margin="0,20,0,0"/>
          </StackPanel>
          <StackPanel x:Name="ActivityView" Visibility="Collapsed">
            <Grid Margin="0,0,0,16"><TextBlock Text="Sorting, hotkeys, Vault copies, and cleanup events." Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><Button Content="Open full log" HorizontalAlignment="Right" Click="OpenLog"/></Grid>
            <ItemsControl ItemsSource="{Binding Activity}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource Surface}" CornerRadius="7" Padding="13,11" Margin="0,0,0,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="67"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Time}" Foreground="#7E8DA4" FontFamily="Consolas" FontSize="11"/><TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" FontSize="12"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </StackPanel>
        </Grid>
      </ScrollViewer>
      <Border Grid.Row="2" BorderBrush="#252E40" BorderThickness="0,1,0,0" Margin="0,19,0,0" Padding="0,14,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="StatusText" Text="Starting…" FontSize="12"/><ProgressBar x:Name="Progress" Height="3" Margin="0,8,20,0" IsIndeterminate="True" Visibility="Collapsed" Foreground="#A790F4" Background="#202638"/></StackPanel><TextBlock Grid.Column="1" x:Name="SavedText" Text="Settings saved" Foreground="#74849C" FontSize="11" VerticalAlignment="Center"/></Grid></Border>
    </Grid>
  </Grid>
</Window>
